# Backend API base URL (FastAPI). Leave the localhost value for local development
# and set the deployed Render URL in Vercel for production.
VITE_API_URL=http://localhost:8000

# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# Only the public "anon" key belongs here. NEVER put the service_role key in a
# VITE_ variable: everything prefixed with VITE_ is bundled into the public JS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
