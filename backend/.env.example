# Copy this file to `backend/.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# --- Required ---

# Google Gemini API key, from https://aistudio.google.com/
# Google AI Studio labels this GEMINI_API_KEY. GOOGLE_API_KEY also works;
# the app accepts either name.
GEMINI_API_KEY=your_gemini_api_key_here

# JSearch (RapidAPI) key, from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here


# --- Required in production ---

# Supabase project URL and anon/public key: the same values as the frontend's
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY. The API uses them to check that
# document generation and link reading come from a signed-in user. Leave them
# empty and those endpoints stay open (fine locally, not on a public deployment).
# Never use the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=


# --- Optional ---

# Limits that keep the free API quotas from running out. Daily counts reset at
# midnight UTC.
# JSEARCH_DAILY_LIMIT=30
# GEMINI_DAILY_LIMIT=450
# SEARCHES_PER_IP_PER_DAY=20
# GENERATIONS_PER_USER_PER_DAY=60

# Comma-separated frontend origins allowed to call this API.
# Leave empty locally (http://localhost:5173 is always allowed).
# In production set this to your deployed frontend URL, no trailing slash:
#   FRONTEND_ORIGINS=https://your-app.vercel.app
FRONTEND_ORIGINS=

# Gemini model to use. The default (gemini-3.5-flash-lite) has a much larger
# free-tier allowance than the full Flash models: 500 requests/day vs 20.
GEMINI_MODEL=gemini-3.5-flash-lite

# Port to listen on. Hosts like Render set this automatically.
PORT=8000
